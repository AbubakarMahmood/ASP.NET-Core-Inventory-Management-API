{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "StockVerity",
    "Audience": "StockVerityUsers",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5001",
      "https://localhost:5001"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrations": false
  },
  "DemoData": {
    "Enabled": false
  },
  "HttpsRedirection": {
    "Enabled": true
  }
}
