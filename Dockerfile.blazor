# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:8.0.423 AS build
WORKDIR /src

COPY global.json ./
COPY src/InventoryAPI.BlazorUI/InventoryAPI.BlazorUI.csproj src/InventoryAPI.BlazorUI/
RUN dotnet restore src/InventoryAPI.BlazorUI/InventoryAPI.BlazorUI.csproj

COPY src/InventoryAPI.BlazorUI/ src/InventoryAPI.BlazorUI/
RUN dotnet publish src/InventoryAPI.BlazorUI/InventoryAPI.BlazorUI.csproj \
    -c Release \
    --no-restore \
    -o /app/publish

FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html

LABEL org.opencontainers.image.title="StockVerity Web" \
      org.opencontainers.image.description="Blazor WebAssembly client for StockVerity"

COPY --from=build /app/publish/wwwroot .
COPY nginx.conf /etc/nginx/nginx.conf
RUN chown -R nginx:nginx /usr/share/nginx/html

USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx", "-g", "daemon off;"]
