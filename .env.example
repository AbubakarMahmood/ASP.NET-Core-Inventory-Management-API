# Copy to .env for the local Compose stack. Never commit real secrets.
POSTGRES_DB=stockverity
POSTGRES_USER=stockverity
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-64-random-characters-before-running-compose
POSTGRES_PORT=5433
API_PORT=5000
UI_PORT=3000
APPLY_MIGRATIONS=true
DEMO_DATA_ENABLED=true
OPENAPI_ENABLED=true
