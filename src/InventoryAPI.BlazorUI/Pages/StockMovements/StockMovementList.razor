@page "/stock-movements"
@attribute [Authorize]
@inject StockMovementService StockMovementService
@inject ProductService ProductService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Stock Ledger - StockVerity</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Stock ledger</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Append-only evidence for every on-hand quantity change.</MudText>
    </div>
    <AuthorizeView Roles="Admin,Manager,Operator">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NavigateToRecord" StartIcon="@Icons.Material.Filled.Add">Post movement</MudButton>
    </AuthorizeView>
</MudStack>

@if (_statistics != null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">Movements</MudText><MudText Typo="Typo.h5">@_statistics.TotalMovements</MudText></MudPaper></MudItem>
        <MudItem xs="6" md="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">Quantity in</MudText><MudText Typo="Typo.h5" Color="Color.Success">+@_statistics.TotalQuantityIn</MudText></MudPaper></MudItem>
        <MudItem xs="6" md="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">Quantity out</MudText><MudText Typo="Typo.h5" Color="Color.Error">-@_statistics.TotalQuantityOut</MudText></MudPaper></MudItem>
        <MudItem xs="6" md="3"><MudPaper Class="pa-3"><MudText Typo="Typo.caption">Net change</MudText><MudText Typo="Typo.h5">@_statistics.NetQuantityChange</MudText></MudPaper></MudItem>
    </MudGrid>
}

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4"><MudTextField @bind-Value="_search" Label="Search loaded rows" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" /></MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="Guid?" @bind-Value="_selectedProductId" Label="Product" Variant="Variant.Outlined" Clearable="true">
                @foreach (var product in _products)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)product.Id)">@product.SKU - @product.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="StockMovementType?" @bind-Value="_selectedType" Label="Type" Variant="Variant.Outlined" Clearable="true">
                @foreach (var type in Enum.GetValues<StockMovementType>())
                {
                    <MudSelectItem T="StockMovementType?" Value="@((StockMovementType?)type)">@type</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudStack Row="true" Spacing="1">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync">Apply</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Info" OnClick="ExportToCsvAsync" Disabled="@(!_movements.Any())" />
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

<MudTable Items="@_movements" Hover="true" Striped="true" Dense="true" Filter="FilterRow">
    <HeaderContent>
        <MudTh>Timestamp (UTC)</MudTh>
        <MudTh>Product</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Signed quantity</MudTh>
        <MudTh>Route</MudTh>
        <MudTh>Reason / reference</MudTh>
        <MudTh>Actor</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Timestamp">@context.Timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="Product"><strong>@context.ProductSKU</strong><br />@context.ProductName</MudTd>
        <MudTd DataLabel="Type"><MudChip Size="Size.Small" Color="@MovementColor(context.Type)">@context.Type</MudChip></MudTd>
        <MudTd DataLabel="Signed quantity"><MudText Color="@DeltaColor(context.QuantityDelta)">@FormatDelta(context.QuantityDelta) @context.UnitOfMeasure</MudText></MudTd>
        <MudTd DataLabel="Route">@context.SourceLocation → @context.DestinationLocation</MudTd>
        <MudTd DataLabel="Reason / reference">
            @context.Reason
            @if (!string.IsNullOrWhiteSpace(context.Reference)) { <br /><MudText Typo="Typo.caption">Ref: @context.Reference</MudText> }
            @if (!string.IsNullOrWhiteSpace(context.WorkOrderNumber)) { <br /><MudText Typo="Typo.caption" Color="Color.Primary">Work order: @context.WorkOrderNumber</MudText> }
        </MudTd>
        <MudTd DataLabel="Actor">@context.PerformedByName</MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" /></PagerContent>
</MudTable>

@if (!_isLoading && !_movements.Any())
{
    <MudAlert Severity="Severity.Info" Class="mt-4">No ledger movements matched the selected filters.</MudAlert>
}

@code {
    private List<StockMovementDto> _movements = new();
    private List<ProductDto> _products = new();
    private StockMovementStatistics? _statistics;
    private Guid? _selectedProductId;
    private StockMovementType? _selectedType;
    private string _search = string.Empty;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadProductsAsync(), LoadDataAsync(), LoadStatisticsAsync());
    }

    private async Task LoadProductsAsync()
    {
        try { _products = (await ProductService.GetProductsAsync(1, 1000))?.Items ?? new(); }
        catch (Exception ex) { Snackbar.Add($"Products could not be loaded: {ex.Message}", Severity.Error); }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _movements = (await StockMovementService.GetStockMovementsAsync(1, 1000, _selectedProductId, _selectedType))?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ledger could not be loaded: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStatisticsAsync()
    {
        try { _statistics = await StockMovementService.GetStatisticsAsync(); }
        catch (Exception ex) { Snackbar.Add($"Statistics could not be loaded: {ex.Message}", Severity.Error); }
    }

    private Task ApplyFiltersAsync() => LoadDataAsync();

    private bool FilterRow(StockMovementDto movement)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return movement.ProductSKU.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || movement.ProductName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || movement.Reason.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (movement.Reference?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || movement.PerformedByName.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private static Color MovementColor(StockMovementType type) => type switch
    {
        StockMovementType.Receipt or StockMovementType.Return or StockMovementType.OpeningBalance => Color.Success,
        StockMovementType.Issue => Color.Error,
        StockMovementType.Adjustment => Color.Warning,
        StockMovementType.Transfer => Color.Info,
        _ => Color.Default
    };

    private static Color DeltaColor(int delta) => delta > 0 ? Color.Success : delta < 0 ? Color.Error : Color.Default;
    private static string FormatDelta(int delta) => delta > 0 ? $"+{delta}" : delta.ToString();
    private void NavigateToRecord() => Navigation.NavigateTo("/stock-movements/record");

    private async Task ExportToCsvAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("TimestampUtc,ProductSku,ProductName,Type,Quantity,QuantityDelta,Unit,Source,Destination,Reason,Reference,WorkOrder,Actor");
        foreach (var movement in _movements)
        {
            csv.AppendLine(string.Join(',', new[]
            {
                Csv(movement.Timestamp.ToUniversalTime().ToString("O")), Csv(movement.ProductSKU), Csv(movement.ProductName),
                Csv(movement.Type.ToString()), movement.Quantity.ToString(), movement.QuantityDelta.ToString(), Csv(movement.UnitOfMeasure),
                Csv(movement.SourceLocation), Csv(movement.DestinationLocation), Csv(movement.Reason), Csv(movement.Reference),
                Csv(movement.WorkOrderNumber), Csv(movement.PerformedByName)
            }));
        }

        var payload = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(csv.ToString()));
        await JS.InvokeVoidAsync("downloadFile", $"StockVerity_Ledger_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv", payload);
    }

    private static string Csv(string? value)
    {
        var safe = value ?? string.Empty;
        if (safe.Length > 0 && "=+-@\t\r".Contains(safe[0])) safe = "'" + safe;
        var escaped = safe.Replace("\"", "\"\"");
        return "\"" + escaped + "\"";
    }
}
