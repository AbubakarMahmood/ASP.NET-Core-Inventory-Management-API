@page "/stock-movements/record"
@attribute [Authorize]
@inject StockMovementService StockMovementService
@inject ProductService ProductService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Post Ledger Movement - StockVerity</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h4" Class="mb-2">Post stock movement</MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Locations are derived from each product's single stock location. Work-order issues must be posted from the work-order workflow so fulfilment and stock remain atomic.
    </MudAlert>

    <MudPaper Elevation="2" Class="pa-4">
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudForm @ref="_form">
                <MudGrid>
                    <MudItem xs="12">
                        <MudSelect T="Guid" @bind-Value="_model.ProductId" Label="Product" Required="true" Variant="Variant.Outlined">
                            @foreach (var product in _products)
                            {
                                <MudSelectItem T="Guid" Value="@product.Id">@product.SKU - @product.Name (@product.CurrentStock @product.UnitOfMeasure)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="StockMovementType" @bind-Value="_model.Type" Label="Movement type" Required="true" Variant="Variant.Outlined">
                            <MudSelectItem T="StockMovementType" Value="@StockMovementType.Receipt">Receipt (stock in)</MudSelectItem>
                            <MudSelectItem T="StockMovementType" Value="@StockMovementType.Issue">Issue (stock out)</MudSelectItem>
                            <MudSelectItem T="StockMovementType" Value="@StockMovementType.Adjustment">Adjustment (signed correction)</MudSelectItem>
                            <MudSelectItem T="StockMovementType" Value="@StockMovementType.Return">Return (stock in)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int" @bind-Value="_model.Quantity" Label="Quantity" Variant="Variant.Outlined" Required="true" />
                        <MudText Typo="Typo.caption">Use a negative quantity only for a downward adjustment.</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Reason" Label="Reason" Variant="Variant.Outlined" Required="true" Lines="3" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Reference" Label="External reference (optional)" Variant="Variant.Outlined" Placeholder="PO-12345, count sheet, return authorization…" />
                    </MudItem>
                </MudGrid>
            </MudForm>

            @if (SelectedProduct != null)
            {
                <MudAlert Severity="@(ProjectedStock < 0 ? Severity.Error : Severity.Info)" Class="mt-4">
                    Current: <strong>@SelectedProduct.CurrentStock @SelectedProduct.UnitOfMeasure</strong> ·
                    Signed delta: <strong>@SignedDelta</strong> ·
                    Projected: <strong>@ProjectedStock @SelectedProduct.UnitOfMeasure</strong>
                </MudAlert>
            }

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Outlined" OnClick="NavigateBack" Disabled="@_isSubmitting">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="@_isSubmitting" StartIcon="@Icons.Material.Filled.Save">Post movement</MudButton>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private readonly RecordStockMovementRequest _model = new();
    private List<ProductDto> _products = new();
    private bool _isLoading = true;
    private bool _isSubmitting;

    private ProductDto? SelectedProduct => _products.FirstOrDefault(product => product.Id == _model.ProductId);

    private int SignedDelta => _model.Type switch
    {
        StockMovementType.Receipt or StockMovementType.Return => _model.Quantity,
        StockMovementType.Issue => _model.Quantity == int.MinValue ? int.MinValue : -_model.Quantity,
        StockMovementType.Adjustment => _model.Quantity,
        _ => 0
    };

    private long ProjectedStock => (long)(SelectedProduct?.CurrentStock ?? 0) + SignedDelta;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ProductService.GetProductsAsync(1, 1000);
            _products = result?.Items ?? new List<ProductDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Products could not be loaded: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_form == null) return;
        await _form.Validate();
        if (!_form.IsValid) return;

        if (_model.ProductId == Guid.Empty || SelectedProduct == null)
        {
            Snackbar.Add("Select a product.", Severity.Error);
            return;
        }

        if (_model.Quantity == 0 || (_model.Type != StockMovementType.Adjustment && _model.Quantity < 0))
        {
            Snackbar.Add("Quantity must be positive, except that adjustments may be signed.", Severity.Error);
            return;
        }

        if (ProjectedStock < 0)
        {
            Snackbar.Add("The movement would make on-hand stock negative.", Severity.Error);
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await StockMovementService.RecordStockMovementAsync(_model);
            if (result == null)
            {
                Snackbar.Add("Movement was not recorded.", Severity.Error);
                return;
            }

            Snackbar.Add($"Ledger movement posted with signed delta {result.QuantityDelta}.", Severity.Success);
            Navigation.NavigateTo("/stock-movements");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Movement failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo("/stock-movements");
}
