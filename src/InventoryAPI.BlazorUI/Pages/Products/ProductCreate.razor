@page "/products/create"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject ProductService ProductService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Create Product - StockVerity</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Create product</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4">
    A non-zero opening quantity is recorded as an immutable opening-balance ledger entry. Later stock changes use the movement screen.
</MudAlert>

<MudPaper Elevation="2" Class="pa-4">
    <EditForm Model="@_product" OnValidSubmit="CreateProductAsync">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_product.SKU" Label="SKU" Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_product.Name" Label="Product name" Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_product.Description" Label="Description" Variant="Variant.Outlined" Lines="3" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_product.Category" Label="Category" Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_product.Location" Label="Stock location" Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField @bind-Value="_product.OpeningStock" Label="Opening stock" Variant="Variant.Outlined" Min="0" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField @bind-Value="_product.ReorderPoint" Label="Reorder point" Variant="Variant.Outlined" Min="0" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="4"><MudNumericField @bind-Value="_product.ReorderQuantity" Label="Reorder quantity" Variant="Variant.Outlined" Min="1" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_product.UnitOfMeasure" Label="Unit of measure" Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting" /></MudItem>
            <MudItem xs="12" md="6"><MudNumericField @bind-Value="_product.UnitCost" Label="Reference unit cost" Variant="Variant.Outlined" Min="0m" Format="N2" Disabled="@_isSubmitting" /></MudItem>
        </MudGrid>
        <MudDivider Class="my-4" />
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined" Href="/products" Disabled="@_isSubmitting">Cancel</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting">Create product</MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    private readonly CreateProductRequest _product = new() { UnitOfMeasure = "EA" };
    private bool _isSubmitting;

    private async Task CreateProductAsync()
    {
        _isSubmitting = true;
        try
        {
            var result = await ProductService.CreateProductAsync(_product);
            if (result == null)
            {
                Snackbar.Add("Product creation failed.", Severity.Error);
                return;
            }

            Snackbar.Add("Product and opening-balance evidence created.", Severity.Success);
            Navigation.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Product creation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
